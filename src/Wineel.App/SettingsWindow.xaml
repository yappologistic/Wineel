<Window x:Class="Wineel.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wineel Settings" Width="880" Height="700" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="Assets/wineel-icon.png" ThemeMode="Dark">
  <Grid Background="{StaticResource BackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="WelcomePanel" Grid.Row="0" Background="#18243B" BorderBrush="#39527D" BorderThickness="0,0,0,1" Padding="24,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image Source="Assets/wineel-icon.png" Width="58" Height="58" Margin="0,0,16,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Welcome to Wineel" FontSize="21" FontWeight="SemiBold" Foreground="#F5F7FB" />
          <TextBlock Text="Try the wheel with Ctrl+Alt+Space. Enable Alt+Tab replacement when you’re ready." Foreground="#B8C3D9" Margin="0,4,16,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Try Wineel" Click="TryWineel_Click" Margin="0,0,8,0" />
          <Button Content="Finish setup" Click="FinishSetup_Click" Background="#3867C8" BorderBrush="#6DA7FF" />
        </StackPanel>
      </Grid>
    </Border>
    <TabControl Grid.Row="1" Margin="18" Background="{StaticResource BackgroundBrush}" Foreground="#F5F7FB" BorderThickness="0" SelectionChanged="AnySettingChanged">
      <TabItem Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22" MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="General" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14" />
          <CheckBox x:Name="ReplaceAltTab" Content="Replace Windows Alt+Tab" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <TextBlock Text="Wineel only suppresses Alt+Tab while a valid switcher session can start." Foreground="#9EABC2" Margin="25,-3,0,12" />
          <TextBlock Text="Fallback shortcut" FontWeight="SemiBold" />
          <TextBox x:Name="FallbackShortcut" LostFocus="AnySettingChanged" />
          <StackPanel Orientation="Horizontal"><Button Content="Restore default shortcuts" Click="RestoreShortcuts_Click"/><Button x:Name="PauseButton" Content="Pause Wineel" Click="Pause_Click" Margin="10,4,0,4"/></StackPanel>
          <Separator Margin="0,16" Background="#2C3852" />
          <CheckBox x:Name="StartWithWindows" Content="Start Wineel with Windows" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <CheckBox x:Name="LaunchMinimized" Content="Launch minimized to the system tray" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <CheckBox x:Name="CurrentDesktopOnly" Content="Include only the current virtual desktop" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <CheckBox x:Name="DisableFullscreen" Content="Disable Wineel while a full-screen application is active" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <TextBlock Text="Application grouping" FontWeight="SemiBold" Margin="0,12,0,0" />
          <ComboBox x:Name="GroupingMode" SelectionChanged="AnySettingChanged"><ComboBoxItem Content="Applications"/><ComboBoxItem Content="Individual windows"/></ComboBox>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Appearance">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22" MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="Appearance" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14" />
          <TextBlock Text="Wheel position" FontWeight="SemiBold"/>
          <ComboBox x:Name="WheelAnchor" SelectionChanged="AnySettingChanged"><ComboBoxItem Content="Center of active monitor"/><ComboBoxItem Content="Follow mouse pointer"/></ComboBox>
          <TextBlock Text="Wheel size" FontWeight="SemiBold"/><Slider x:Name="WheelSize" Minimum="340" Maximum="650" TickFrequency="10" ValueChanged="AnySettingChanged"/>
          <TextBlock Text="Icon size" FontWeight="SemiBold"/><Slider x:Name="IconSize" Minimum="48" Maximum="92" TickFrequency="2" ValueChanged="AnySettingChanged"/>
          <TextBlock Text="Maximum visible icons" FontWeight="SemiBold"/><Slider x:Name="MaximumVisible" Minimum="4" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AnySettingChanged"/>
          <TextBlock Text="Plate opacity" FontWeight="SemiBold"/><Slider x:Name="PlateOpacity" Minimum="0.35" Maximum="0.95" TickFrequency="0.05" ValueChanged="AnySettingChanged"/>
          <TextBlock Text="Beam intensity" FontWeight="SemiBold"/><Slider x:Name="BeamIntensity" Minimum="0" Maximum="0.75" TickFrequency="0.05" ValueChanged="AnySettingChanged"/>
          <TextBlock Text="Animation speed" FontWeight="SemiBold"/><Slider x:Name="AnimationSpeed" Minimum="0.5" Maximum="2" TickFrequency="0.1" ValueChanged="AnySettingChanged"/>
          <CheckBox x:Name="ShowLabels" Content="Show application labels" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <CheckBox x:Name="ShowBadges" Content="Show number badges" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,10,0,0"/>
          <ComboBox x:Name="ThemeModePicker" SelectionChanged="AnySettingChanged"><ComboBoxItem Content="Follow Windows"/><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/></ComboBox>
          <TextBlock Text="Motion" FontWeight="SemiBold"/>
          <ComboBox x:Name="MotionMode" SelectionChanged="AnySettingChanged"><ComboBoxItem Content="Follow Windows"/><ComboBoxItem Content="Reduced motion"/><ComboBoxItem Content="Full motion"/></ComboBox>
          <Button Content="Preview Wineel" Click="TryWineel_Click" HorizontalAlignment="Left" />
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Input">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22" MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="Input" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14" />
          <CheckBox x:Name="ReverseWheel" Content="Reverse mouse-wheel direction" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <CheckBox x:Name="RepeatTab" Content="Repeated Tab changes selection" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <CheckBox x:Name="MouseClickSelection" Content="Click an icon to activate it" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <CheckBox x:Name="WrapSelection" Content="Wrap selection at both ends" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <Button Content="Reset input settings" Click="ResetInput_Click" HorizontalAlignment="Left" Margin="0,14,0,0" />
          <Border Background="#131B2B" BorderBrush="#2C3852" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,22,0,0">
            <StackPanel><TextBlock Text="Controls" FontSize="16" FontWeight="SemiBold"/><TextBlock Margin="0,8,0,0" Foreground="#B8C3D9" TextWrapping="Wrap" Text="Wheel or arrows: change selection   •   Tab / Shift+Tab: next / previous   •   1–9, 0: choose visible badge   •   Enter: activate   •   Escape: cancel"/></StackPanel>
          </Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Exclusions">
        <Grid Margin="22" MaxWidth="720" HorizontalAlignment="Left">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Exclusions" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Excluded paths and application identities remain safe if an app is later uninstalled." Foreground="#9EABC2" Margin="0,5,0,14"/></StackPanel>
          <ListBox x:Name="Exclusions" Grid.Row="1" MinWidth="650" Background="#111827" BorderBrush="#34415D" Foreground="#F5F7FB" />
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Add current application" Click="AddCurrent_Click"/><Button Content="Remove selected" Click="RemoveExclusion_Click" Margin="10,4,0,4"/></StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>

<Window x:Class="Wineel.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Wineel"
        Title="Wineel Settings" Width="1120" Height="760" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="Assets/wineel-icon-fluent.png">
  <Grid Background="{DynamicResource BackgroundBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource NavigationBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="20,20,14,15">
          <Image Source="Assets/wineel-icon-fluent.png" Width="30" Height="30" Margin="0,0,10,0" />
          <TextBlock Text="Wineel" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1">
          <RadioButton x:Name="GeneralNav" GroupName="Navigation" Content="General" Tag="0" IsChecked="True" Style="{StaticResource NavigationItemStyle}" Checked="Navigation_Checked" />
          <RadioButton x:Name="AppearanceNav" GroupName="Navigation" Content="Appearance" Tag="1" Style="{StaticResource NavigationItemStyle}" Checked="Navigation_Checked" />
          <RadioButton x:Name="InputNav" GroupName="Navigation" Content="Input" Tag="2" Style="{StaticResource NavigationItemStyle}" Checked="Navigation_Checked" />
          <RadioButton x:Name="FavoritesNav" GroupName="Navigation" Content="Favorites" Tag="3" Style="{StaticResource NavigationItemStyle}" Checked="Navigation_Checked" />
          <RadioButton x:Name="ExclusionsNav" GroupName="Navigation" Content="Exclusions" Tag="4" Style="{StaticResource NavigationItemStyle}" Checked="Navigation_Checked" />
        </StackPanel>
        <TextBlock x:Name="SaveStatusText" Grid.Row="2" Text="Settings save automatically" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="20,10,14,20" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="30,25,30,15">
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="General" Style="{StaticResource PageTitleStyle}" />
          <TextBlock x:Name="PageSubtitle" Text="Core behavior for how Wineel launches, shows, and works on your system." Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="30,0,30,30">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <StackPanel>
              <Border x:Name="WelcomePanel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Welcome to Wineel" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Try the wheel first, then enable Alt+Tab replacement when you are ready." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Try Wineel" Click="TryWineel_Click" Margin="0,0,8,0" />
                    <Button Content="Finish setup" Click="FinishSetup_Click" Style="{StaticResource AccentButtonStyle}" />
                  </StackPanel>
                </Grid>
              </Border>

              <local:SettingRow Header="Replace Windows Alt+Tab" Description="Safe, native, and reversible. Windows remains available if Wineel cannot start." IsHero="True" Margin="0,0,0,12">
                <CheckBox x:Name="ReplaceAltTab" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Replace Windows Alt+Tab" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
              </local:SettingRow>

              <local:SettingCard Header="Activation">
                <Border Padding="14,12">
                  <StackPanel>
                    <TextBlock Text="Fallback shortcut" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Used when Alt+Tab replacement is unavailable." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" />
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBox x:Name="FallbackShortcut" AutomationProperties.Name="Fallback shortcut" TextChanged="FallbackShortcut_TextChanged" LostFocus="FallbackShortcut_LostFocus" />
                      <Button Grid.Column="1" Content="Restore" Click="RestoreShortcuts_Click" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="ShortcutValidationText" Text="Shortcut is valid" Foreground="{DynamicResource SuccessBrush}" FontSize="12" Margin="1,4,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                </Border>
              </local:SettingCard>

              <local:SettingCard Header="Startup &amp; tray">
                <StackPanel>
                  <local:SettingRow Header="Start Wineel with Windows" Description="Launch automatically when you sign in."><CheckBox x:Name="StartWithWindows" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Start Wineel with Windows" Checked="AnySettingChanged" Unchecked="AnySettingChanged" /></local:SettingRow>
                  <local:SettingRow Header="Launch minimized to the system tray" Description="Wineel will start quietly in the background."><CheckBox x:Name="LaunchMinimized" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Launch minimized to the system tray" Checked="AnySettingChanged" Unchecked="AnySettingChanged" /></local:SettingRow>
                </StackPanel>
              </local:SettingCard>

              <local:SettingCard Header="Behavior">
                <StackPanel>
                  <local:SettingRow Header="Include only the current virtual desktop" Description="Show apps from the desktop you are currently using."><CheckBox x:Name="CurrentDesktopOnly" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Include only the current virtual desktop" Checked="AnySettingChanged" Unchecked="AnySettingChanged" /></local:SettingRow>
                  <local:SettingRow Header="Disable in full-screen applications" Description="Prevent Wineel from appearing over full-screen apps."><CheckBox x:Name="DisableFullscreen" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Disable Wineel in full-screen applications" Checked="AnySettingChanged" Unchecked="AnySettingChanged" /></local:SettingRow>
                </StackPanel>
              </local:SettingCard>

              <local:SettingCard Header="Organization">
                <local:SettingRow Header="Application grouping" Description="Choose whether the wheel groups an app's windows."><ComboBox x:Name="GroupingMode" AutomationProperties.Name="Application grouping" SelectionChanged="AnySettingChanged"><ComboBoxItem Content="Applications"/><ComboBoxItem Content="Individual windows"/></ComboBox></local:SettingRow>
              </local:SettingCard>
              <Button x:Name="PauseButton" Content="Pause Wineel" Click="Pause_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,0" />
            </StackPanel>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="Wheel preview" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Open a live preview with your current applications and settings." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,16" TextWrapping="Wrap" />
                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="120" Width="220" Height="220" HorizontalAlignment="Center" Margin="0,8,0,18">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="Assets/wineel-icon-fluent.png" Width="70" Height="70" />
                    <TextBlock Text="Wineel" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock Text="Type to search" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                  </StackPanel>
                </Border>
                <Button Content="Preview Wineel" Click="TryWineel_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>

        <ScrollViewer x:Name="AppearancePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="30,0,30,30" MaxWidth="760" HorizontalAlignment="Left">
            <local:SettingCard Header="Layout">
              <StackPanel>
                <local:SettingRow Header="Wheel position" Description="Choose where the switcher appears."><ComboBox x:Name="WheelAnchor" AutomationProperties.Name="Wheel position" SelectionChanged="AnySettingChanged"><ComboBoxItem Content="Center of active monitor"/><ComboBoxItem Content="Follow mouse pointer"/></ComboBox></local:SettingRow>
                <local:SettingRow Header="Wheel size" Description="Overall diameter of the switcher."><StackPanel Width="260"><TextBlock x:Name="WheelSizeValue" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/><Slider x:Name="WheelSize" AutomationProperties.Name="Wheel size in pixels" Minimum="340" Maximum="650" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="AnySettingChanged"/></StackPanel></local:SettingRow>
                <local:SettingRow Header="Icon size" Description="Size of application icons."><StackPanel Width="260"><TextBlock x:Name="IconSizeValue" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/><Slider x:Name="IconSize" AutomationProperties.Name="Icon size in pixels" Minimum="48" Maximum="92" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="AnySettingChanged"/></StackPanel></local:SettingRow>
                <local:SettingRow Header="Maximum visible icons" Description="Limit crowding on smaller wheels."><StackPanel Width="260"><TextBlock x:Name="MaximumVisibleValue" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/><Slider x:Name="MaximumVisible" AutomationProperties.Name="Maximum visible icons" Minimum="4" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AnySettingChanged"/></StackPanel></local:SettingRow>
              </StackPanel>
            </local:SettingCard>
            <local:SettingCard Header="Visual treatment">
              <StackPanel>
                <local:SettingRow Header="Plate opacity" Description="Increase separation from the app underneath."><StackPanel Width="260"><TextBlock x:Name="PlateOpacityValue" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/><Slider x:Name="PlateOpacity" AutomationProperties.Name="Plate opacity percentage" Minimum="0.55" Maximum="0.98" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="AnySettingChanged"/></StackPanel></local:SettingRow>
                <local:SettingRow Header="Selection glow" Description="Adjust the selected app emphasis."><StackPanel Width="260"><TextBlock x:Name="BeamIntensityValue" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/><Slider x:Name="BeamIntensity" AutomationProperties.Name="Selection glow percentage" Minimum="0" Maximum="0.55" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="AnySettingChanged"/></StackPanel></local:SettingRow>
                <local:SettingRow Header="Animation speed" Description="Controls selection and opening motion."><StackPanel Width="260"><TextBlock x:Name="AnimationSpeedValue" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/><Slider x:Name="AnimationSpeed" AutomationProperties.Name="Animation speed multiplier" Minimum="0.5" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="AnySettingChanged"/></StackPanel></local:SettingRow>
              </StackPanel>
            </local:SettingCard>
            <local:SettingCard Header="Labels &amp; accessibility">
              <StackPanel>
                <local:SettingRow Header="Show application labels" Description="Display the selected application name."><CheckBox x:Name="ShowLabels" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Show application labels" Checked="AnySettingChanged" Unchecked="AnySettingChanged" /></local:SettingRow>
                <local:SettingRow Header="Show number shortcuts" Description="Display stable keyboard shortcut badges."><CheckBox x:Name="ShowBadges" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Show number shortcuts" Checked="AnySettingChanged" Unchecked="AnySettingChanged" /></local:SettingRow>
                <local:SettingRow Header="Theme" Description="Follow Windows or choose a fixed theme."><ComboBox x:Name="ThemeModePicker" AutomationProperties.Name="Theme" SelectionChanged="AnySettingChanged"><ComboBoxItem Content="Follow Windows"/><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/></ComboBox></local:SettingRow>
                <local:SettingRow Header="Motion" Description="Follow Windows or override animation preferences."><ComboBox x:Name="MotionMode" AutomationProperties.Name="Motion preference" SelectionChanged="AnySettingChanged"><ComboBoxItem Content="Follow Windows"/><ComboBoxItem Content="Reduced motion"/><ComboBoxItem Content="Full motion"/></ComboBox></local:SettingRow>
              </StackPanel>
            </local:SettingCard>
            <Button Content="Preview Wineel" Click="TryWineel_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,16,0,0" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="InputPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="30,0,30,30" MaxWidth="760" HorizontalAlignment="Left">
            <local:SettingCard Header="Navigation">
              <StackPanel>
                <local:SettingRow Header="Reverse mouse-wheel direction" Description="Swap next and previous when scrolling."><CheckBox x:Name="ReverseWheel" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Reverse mouse-wheel direction" Checked="AnySettingChanged" Unchecked="AnySettingChanged" /></local:SettingRow>
                <local:SettingRow Header="Repeated Tab changes selection" Description="Continue cycling while Alt remains held."><CheckBox x:Name="RepeatTab" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Repeated Tab changes selection" Checked="AnySettingChanged" Unchecked="AnySettingChanged" /></local:SettingRow>
                <local:SettingRow Header="Click an icon to activate it" Description="Mouse clicks switch immediately."><CheckBox x:Name="MouseClickSelection" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Click an icon to activate it" Checked="AnySettingChanged" Unchecked="AnySettingChanged" /></local:SettingRow>
                <local:SettingRow Header="Wrap selection at both ends" Description="Continue from the first or last application."><CheckBox x:Name="WrapSelection" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Wrap selection at both ends" Checked="AnySettingChanged" Unchecked="AnySettingChanged" /></local:SettingRow>
              </StackPanel>
            </local:SettingCard>
            <Button Content="Reset input settings" Click="ResetInput_Click" HorizontalAlignment="Left" Margin="0,16,0,0" />
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,20,0,0">
              <StackPanel>
                <TextBlock Text="Keyboard controls" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="23" Text="Type to search&#x0a;Space to choose a grouped window&#x0a;Backspace to erase or return&#x0a;Ctrl+P or right-click to pin&#x0a;Wheel, Tab, or arrows to move&#x0a;Enter to activate • Escape to cancel" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid x:Name="FavoritesPage" Visibility="Collapsed" Margin="30,0,30,30" MaxWidth="820" HorizontalAlignment="Left">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Pinned applications stay at the front of the wheel." FontWeight="SemiBold" />
              <TextBlock Text="Add an executable here, or press Ctrl+P on an application while the wheel is open." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Grid Grid.Row="1">
            <ListBox x:Name="PinnedIdentities" SelectionChanged="FavoriteSelectionChanged" AutomationProperties.Name="Favorite applications" />
            <StackPanel x:Name="FavoritesEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock Text="No favorites yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="Add an application or pin one from the wheel." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Add application…" Click="AddFavorite_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="AddFavoriteCandidateButton" Content="Add previous application" Click="AddFavoriteCandidate_Click" Margin="8,0,0,0" />
            <Button x:Name="RemoveFavoriteButton" Content="Remove selected" Click="RemoveFavorite_Click" Margin="8,0,0,0" IsEnabled="False" />
          </StackPanel>
        </Grid>

        <Grid x:Name="ExclusionsPage" Visibility="Collapsed" Margin="30,0,30,30" MaxWidth="820" HorizontalAlignment="Left">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Excluded applications never appear in the wheel." FontWeight="SemiBold" />
              <TextBlock Text="Browse directly or add the application that was active immediately before Settings opened." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Grid Grid.Row="1">
            <ListBox x:Name="Exclusions" SelectionChanged="ExclusionSelectionChanged" AutomationProperties.Name="Excluded applications" />
            <StackPanel x:Name="ExclusionsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock Text="No excluded applications" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="Wineel currently includes every eligible application." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Add application…" Click="BrowseExclusion_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="AddExclusionButton" Content="Add previous application" Click="AddCurrent_Click" Margin="8,0,0,0" />
            <Button x:Name="RemoveExclusionButton" Content="Remove selected" Click="RemoveExclusion_Click" Margin="8,0,0,0" IsEnabled="False" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>

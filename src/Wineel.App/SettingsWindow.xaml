<Window x:Class="Wineel.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wineel Settings" Width="880" Height="700" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen" Icon="Assets/wineel-icon.png">
  <Grid Background="{DynamicResource BackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="WelcomePanel" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image Source="Assets/wineel-icon.png" Width="58" Height="58" Margin="0,0,16,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Welcome to Wineel" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="Try the wheel with Ctrl+Alt+Space. Enable Alt+Tab replacement when you’re ready." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,16,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Try Wineel" Click="TryWineel_Click" Margin="0,0,8,0" />
          <Button Content="Finish setup" Click="FinishSetup_Click" BorderBrush="{DynamicResource AccentBrush}" />
        </StackPanel>
      </Grid>
    </Border>
    <TabControl Grid.Row="1" Margin="18" Background="{DynamicResource BackgroundBrush}" BorderThickness="0">
      <TabItem Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><StackPanel Margin="22" MaxWidth="720">
          <TextBlock Text="General" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14" />
          <CheckBox x:Name="ReplaceAltTab" Content="Replace Windows Alt+Tab" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <TextBlock Text="Wineel only suppresses Alt+Tab while a valid switcher session can start." Foreground="{DynamicResource TextSecondaryBrush}" Margin="25,-3,0,12" />
          <TextBlock Text="Fallback shortcut" FontWeight="SemiBold" />
          <TextBox x:Name="FallbackShortcut" AutomationProperties.Name="Fallback shortcut" LostFocus="AnySettingChanged" />
          <StackPanel Orientation="Horizontal"><Button Content="Restore default shortcuts" Click="RestoreShortcuts_Click"/><Button x:Name="PauseButton" Content="Pause Wineel" Click="Pause_Click" Margin="10,4,0,4"/></StackPanel>
          <Separator Margin="0,16" Background="{DynamicResource BorderBrush}" />
          <CheckBox x:Name="StartWithWindows" Content="Start Wineel with Windows" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <CheckBox x:Name="LaunchMinimized" Content="Launch minimized to the system tray" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <CheckBox x:Name="CurrentDesktopOnly" Content="Include only the current virtual desktop" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <CheckBox x:Name="DisableFullscreen" Content="Disable Wineel while a full-screen application is active" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <TextBlock Text="Application grouping" FontWeight="SemiBold" Margin="0,12,0,0" />
          <ComboBox x:Name="GroupingMode" AutomationProperties.Name="Application grouping" SelectionChanged="AnySettingChanged"><ComboBoxItem Content="Applications"/><ComboBoxItem Content="Individual windows"/></ComboBox>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Appearance">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><StackPanel Margin="22" MaxWidth="720">
          <TextBlock Text="Appearance" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14" />
          <TextBlock Text="Wheel position" FontWeight="SemiBold"/>
          <ComboBox x:Name="WheelAnchor" AutomationProperties.Name="Wheel position" SelectionChanged="AnySettingChanged"><ComboBoxItem Content="Center of active monitor"/><ComboBoxItem Content="Follow mouse pointer"/></ComboBox>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Wheel size" FontWeight="SemiBold"/><TextBlock x:Name="WheelSizeValue" Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid>
          <Slider x:Name="WheelSize" AutomationProperties.Name="Wheel size in pixels" Minimum="340" Maximum="650" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="AnySettingChanged"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Icon size" FontWeight="SemiBold"/><TextBlock x:Name="IconSizeValue" Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid>
          <Slider x:Name="IconSize" AutomationProperties.Name="Icon size in pixels" Minimum="48" Maximum="92" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="AnySettingChanged"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Maximum visible icons" FontWeight="SemiBold"/><TextBlock x:Name="MaximumVisibleValue" Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid>
          <Slider x:Name="MaximumVisible" AutomationProperties.Name="Maximum visible icons" Minimum="4" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AnySettingChanged"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Plate opacity" FontWeight="SemiBold"/><TextBlock x:Name="PlateOpacityValue" Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid>
          <Slider x:Name="PlateOpacity" AutomationProperties.Name="Plate opacity percentage" Minimum="0.35" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="AnySettingChanged"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Beam intensity" FontWeight="SemiBold"/><TextBlock x:Name="BeamIntensityValue" Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid>
          <Slider x:Name="BeamIntensity" AutomationProperties.Name="Beam intensity percentage" Minimum="0" Maximum="0.75" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="AnySettingChanged"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Animation speed" FontWeight="SemiBold"/><TextBlock x:Name="AnimationSpeedValue" Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid>
          <Slider x:Name="AnimationSpeed" AutomationProperties.Name="Animation speed multiplier" Minimum="0.5" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="AnySettingChanged"/>
          <CheckBox x:Name="ShowLabels" Content="Show application labels" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <CheckBox x:Name="ShowBadges" Content="Show number badges" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,10,0,0"/>
          <ComboBox x:Name="ThemeModePicker" AutomationProperties.Name="Theme" SelectionChanged="AnySettingChanged"><ComboBoxItem Content="Follow Windows"/><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/></ComboBox>
          <TextBlock Text="Motion" FontWeight="SemiBold"/>
          <ComboBox x:Name="MotionMode" AutomationProperties.Name="Motion preference" SelectionChanged="AnySettingChanged"><ComboBoxItem Content="Follow Windows"/><ComboBoxItem Content="Reduced motion"/><ComboBoxItem Content="Full motion"/></ComboBox>
          <Button Content="Preview Wineel" Click="TryWineel_Click" HorizontalAlignment="Left" />
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Input">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><StackPanel Margin="22" MaxWidth="720">
          <TextBlock Text="Input" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14" />
          <CheckBox x:Name="ReverseWheel" Content="Reverse mouse-wheel direction" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <CheckBox x:Name="RepeatTab" Content="Repeated Tab changes selection" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <CheckBox x:Name="MouseClickSelection" Content="Click an icon to activate it" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <CheckBox x:Name="WrapSelection" Content="Wrap selection at both ends" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
          <Button Content="Reset input settings" Click="ResetInput_Click" HorizontalAlignment="Left" Margin="0,14,0,0" />
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,22,0,0">
            <StackPanel><TextBlock Text="Controls" FontSize="16" FontWeight="SemiBold"/><TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="Type: search   •   Space: choose a grouped window   •   Backspace: erase or return   •   Ctrl+P / right-click: pin   •   Wheel, Tab, or arrows: move   •   Enter: activate   •   Escape: cancel"/></StackPanel>
          </Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Favorites">
        <Grid Margin="22" MaxWidth="720" HorizontalAlignment="Stretch">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Favorites" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Pinned applications stay at the front of the wheel. Press Ctrl+P or right-click an icon while Wineel is open to pin it." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,14" TextWrapping="Wrap"/></StackPanel>
          <Grid Grid.Row="1"><ListBox x:Name="PinnedIdentities" SelectionChanged="FavoriteSelectionChanged"/><StackPanel x:Name="FavoritesEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="No favorites yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Open the wheel and press Ctrl+P on an app." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel></Grid>
          <Button x:Name="RemoveFavoriteButton" Grid.Row="2" Content="Remove selected favorite" Click="RemoveFavorite_Click" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="False"/>
        </Grid>
      </TabItem>
      <TabItem Header="Exclusions">
        <Grid Margin="22" MaxWidth="720" HorizontalAlignment="Stretch">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Exclusions" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Exclude the app that was active immediately before Settings opened." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,14"/></StackPanel>
          <Grid Grid.Row="1"><ListBox x:Name="Exclusions" SelectionChanged="ExclusionSelectionChanged"/><StackPanel x:Name="ExclusionsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="No excluded applications" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Focus an app, then reopen Settings to add it." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel></Grid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="AddExclusionButton" Content="Exclude previous application" Click="AddCurrent_Click"/><Button x:Name="RemoveExclusionButton" Content="Remove selected" Click="RemoveExclusion_Click" Margin="10,4,0,4" IsEnabled="False"/></StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
